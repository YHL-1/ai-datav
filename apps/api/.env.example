# 后端环境变量示例，复制为 .env 后按需修改
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# 允许的前端来源，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173
# 登录会话有效期（天）
SESSION_TTL_DAYS=7

# 数据库（MySQL 9.1）
DATABASE_URL=mysql://root:1234@127.0.0.1:3306/nexa

# QQ 邮箱 SMTP 发信（用于注册验证码）
# 1. 登录 QQ 邮箱 -> 设置 -> 账号 -> 开启「POP3/SMTP 服务」
# 2. 按提示获取 16 位授权码，填到 SMTP_AUTH_CODE
# 留空时开发环境不发信，验证码打印在后端控制台
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_EMAIL=your-qq-number@qq.com
SMTP_AUTH_CODE=

# 上传数据文件的本地目录（相对后端工作目录）
UPLOAD_DIR=uploads
